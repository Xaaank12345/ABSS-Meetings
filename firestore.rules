rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdminOrManagement() {
      return isSignedIn() && (
        request.auth.token.email == 'xaaaank@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'management'])
      );
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if isSignedIn();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /departments/{departmentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /meetings/{meetingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /meetingSubmissions/{submissionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /followUpUpdates/{updateId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /proposedAgendaItems/{itemId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /actionItems/{actionItemId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /actionHistory/{historyId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
